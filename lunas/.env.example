# Copia este archivo a .env.local y rellena los valores.

# Secreto para firmar la sesión. Genera uno con:  npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=

# Credenciales OAuth de Google (Google Cloud Console → APIs y servicios → Credenciales)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cadena de conexión de MongoDB Atlas (o cualquier MongoDB)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Nombre de la base de datos (opcional, por defecto "lunas")
MONGODB_DB=lunas

# Solo fuera de Vercel (Docker, Render, Railway...): pon la URL pública y confía en el host.
# AUTH_URL=https://lunas.midominio.com
# AUTH_TRUST_HOST=true
